# iOS signing config for ./generate_new_ios_version
#
# Copy this file to .env.ios.local and fill in your real values:
#     cp .env.ios.example .env.ios.local
# .env.ios.local is gitignored (matches *.local) so your values never get committed.
# Alternatively, export these in your shell profile (~/.zshrc) instead of using this file.

# Apple Developer Team ID (10 chars) — Apple Developer portal → Membership → Team ID.
KUNA_IOS_TEAM_ID=YOURTEAMID

# App Store provisioning profile name, exactly as it appears in the Developer portal / Xcode.
# Quote it — the script sources this file, so a value with spaces MUST be in quotes.
KUNA_IOS_PROFILE="Your App Store profile name"

# Code-signing identity (optional — defaults to "Apple Distribution").
# KUNA_IOS_IDENTITY=Apple Distribution
