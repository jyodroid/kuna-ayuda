    <string name="story_after_3">Evacúa con calma</string>
    <string name="story_pets_1">Kit para tu mascota</string>
    <string name="story_pets_2">Mantén tu mascota cerca</string>
    <string name="story_pets_3">Con correa antes de salir</string>
    <string name="story_calm_1">Respira profundo</string>
    <string name="story_calm_2">Exhala despacio</string>
    <string name="story_calm_3">Siente tus pies en el suelo</string>
    <string name="story_children_1">Abrázalo y tranquilízalo</string>
    <string name="story_children_2">Escúchalo con calma</string>
    <string name="story_children_3">Mantén la rutina juntos</string>

    <string name="tip_before_1_title">Prepara un kit de emergencia</string>
    <string name="tip_before_1_body">Agua, alimentos no perecederos, linterna, radio, botiquín, documentos y un silbato.</string>
    <string name="tip_before_2_title">Asegura tu vivienda</string>
    <string name="tip_before_2_body">Fija estanterías y objetos pesados; identifica lugares seguros bajo muebles resistentes.</string>
    <string name="tip_before_3_title">Acuerda un punto de encuentro</string>
    <string name="tip_before_3_body">Define con tu familia un lugar de reunión y un contacto fuera de la ciudad.</string>

    <string name="tip_during_1_title">Agáchate, cúbrete y sujétate</string>
    <string name="tip_during_1_body">Protege cabeza y cuello bajo un mueble resistente hasta que termine el movimiento.</string>
    <string name="tip_during_2_title">Aléjate de ventanas</string>
    <string name="tip_during_2_body">Evita vidrios, fachadas y objetos que puedan caer. No uses ascensores.</string>
    <string name="tip_during_3_title">Si estás afuera o conduciendo</string>
    <string name="tip_during_3_body">Ve a un espacio abierto lejos de cables y edificios; si conduces, detente con cuidado.</string>

    <string name="tip_after_1_title">Revisa heridas y prepárate para réplicas</string>
    <string name="tip_after_1_body">Atiende heridas, mantén la calma y espera posibles réplicas.</string>
    <string name="tip_after_2_title">Corta el gas si hueles una fuga</string>
    <string name="tip_after_2_body">Cierra el gas, no enciendas llamas ni interruptores y ventila el lugar.</string>
    <string name="tip_after_3_title">Comunícate por mensajes de texto</string>
    <string name="tip_after_3_body">Usa mensajes de texto para no saturar las redes y revisa a tus vecinos.</string>

    <string name="tip_mental_line_title">Línea de salud mental: %1$s</string>
    <string name="tip_mental_line_body">Atención psicológica gratuita y confidencial. Si hay riesgo para la vida, llama al %1$s.</string>
    <string name="tip_mental_1_title">Línea de salud mental: 192, opción 4</string>
    <string name="tip_mental_1_body">Atención psicológica nacional, gratuita y 24 horas. En Bogotá también puedes llamar a la Línea 106. Si hay riesgo para la vida, llama al 123.</string>
    <string name="tip_mental_2_title">Tus reacciones son normales</string>
    <string name="tip_mental_2_body">Miedo, insomnio, tristeza o rabia tras un sismo son respuestas comunes. Habla de lo que sientes y no lo enfrentes en soledad.</string>
    <string name="tip_mental_3_title">Técnicas para calmarte</string>
    <string name="tip_mental_3_body">Respira despacio (inhala 4s, exhala 6s), mantén rutinas de sueño y comida, y limita la exposición a noticias e imágenes del desastre.</string>
    <string name="tip_mental_4_title">Acompaña a niñas y niños</string>
    <string name="tip_mental_4_body">Escúchalos, respóndeles con calma y honestidad, mantén rutinas y recuérdales que están a salvo. Busca apoyo profesional si el malestar persiste.</string>
    <string name="tip_mental_5_title">Contenido de apoyo (comunidad)</string>
    <string name="tip_mental_5_body">Cuenta informativa en Instagram: @saludmental_paracolombia. Es un recurso de la comunidad, no una línea oficial de emergencia; ante una crisis usa la Línea 192 (opción 4) o el 123.</string>

    <string name="tip_animals_1_title">Si evacúas, lleva a tu mascota</string>
    <string name="tip_animals_1_body">Nunca la dejes atrás. Usa guacal o correa, lleva agua, algo de comida y una identificación con tu teléfono. Mantenla cerca y con placa o microchip.</string>
    <string name="tip_animals_2_title">Refugios que reciben ayuda</string>
    <string name="tip_animals_2_body">Varias fundaciones afectadas reciben alimento, medicamentos e insumos (p. ej. en Pereira, Armenia, Manizales y Villa María). Verifica los canales antes de donar; muchos se difunden por Protección Animal Javeriana.</string>
    <string name="tip_animals_3_title">Atención veterinaria</string>
    <string name="tip_animals_3_body">Hay veterinarios y clínicas atendiendo mascotas afectadas en zonas del sismo (p. ej. Royi Pets en Cali recibe animales desorientados). Confirma disponibilidad antes de trasladarte.</string>
    <string name="tip_animals_4_title">Buscador de mascotas perdidas</string>
    <string name="tip_animals_4_body">La plataforma comunitaria «Buscador de Personas y Mascotas — terremoto Colombia» permite reportar y buscar mascotas extraviadas. Es un recurso de la comunidad; verifica los datos antes de actuar.</string>
    <string name="desktop_number_copied">Número copiado al portapapeles</string>
