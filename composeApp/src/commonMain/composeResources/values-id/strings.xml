    <string name="tip_before_2_body">Kunci rak dan benda berat; kenali tempat aman di bawah perabot kokoh.</string>
    <string name="tip_before_3_title">Sepakati titik temu</string>
    <string name="tip_before_3_body">Pilih titik temu keluarga dan kontak di luar kota.</string>

    <string name="tip_during_1_title">Merunduk, berlindung, dan berpegangan</string>
    <string name="tip_during_1_body">Lindungi kepala dan leher di bawah perabot kokoh hingga guncangan berhenti.</string>
    <string name="tip_during_2_title">Jauhi jendela</string>
    <string name="tip_during_2_body">Hindari kaca, fasad, dan benda jatuh. Jangan gunakan lift.</string>
    <string name="tip_during_3_title">Jika di luar atau mengemudi</string>
    <string name="tip_during_3_body">Pindah ke area terbuka jauh dari kabel dan bangunan; jika mengemudi, berhenti dengan aman.</string>

    <string name="tip_after_1_title">Periksa cedera dan waspadai gempa susulan</string>
    <string name="tip_after_1_body">Tangani cedera, tetap tenang, dan bersiap untuk gempa susulan.</string>
    <string name="tip_after_2_title">Matikan gas jika tercium kebocoran</string>
    <string name="tip_after_2_body">Matikan gas, jangan gunakan api atau sakelar, dan ventilasi area.</string>
    <string name="tip_after_3_title">Berkomunikasi lewat pesan teks</string>
    <string name="tip_after_3_body">Gunakan pesan teks agar jaringan tidak penuh dan periksa tetangga Anda.</string>

    <string name="tip_mental_line_title">Saluran kesehatan mental: %1$s</string>
    <string name="tip_mental_line_body">Dukungan psikologis gratis dan rahasia. Jika nyawa terancam, hubungi %1$s.</string>
    <string name="tip_mental_1_title">Saluran kesehatan mental: 192, opsi 4</string>
    <string name="tip_mental_1_body">Dukungan psikologis nasional gratis 24 jam. Di Bogotá Anda juga dapat menghubungi Saluran 106. Jika nyawa terancam, hubungi 123.</string>
    <string name="tip_mental_2_title">Reaksi Anda normal</string>
    <string name="tip_mental_2_body">Takut, sulit tidur, sedih, atau marah setelah gempa adalah respons umum. Bicarakan perasaan Anda dan jangan menghadapinya sendiri.</string>
    <string name="tip_mental_3_title">Teknik menenangkan diri</string>
    <string name="tip_mental_3_body">Bernapas perlahan (tarik 4 dtk, embus 6 dtk), jaga rutinitas tidur dan makan, dan batasi paparan berita serta gambar bencana.</string>
    <string name="tip_mental_4_title">Dampingi anak-anak</string>
    <string name="tip_mental_4_body">Dengarkan mereka, jawab dengan tenang dan jujur, jaga rutinitas, dan ingatkan bahwa mereka aman. Cari bantuan profesional jika tekanan berlanjut.</string>
    <string name="tip_mental_5_title">Konten dukungan (komunitas)</string>
    <string name="tip_mental_5_body">Akun Instagram informatif: @saludmental_paracolombia. Ini sumber komunitas, bukan saluran darurat resmi; saat krisis gunakan Saluran 192 (opsi 4) atau 123.</string>

    <string name="tip_animals_1_title">Jika mengungsi, bawa hewan peliharaan Anda</string>
    <string name="tip_animals_1_body">Jangan pernah meninggalkannya. Gunakan kandang angkut atau tali, bawa air, sedikit makanan, dan tanda pengenal dengan nomor telepon Anda. Jaga tetap dekat, berpenanda atau ber-microchip.</string>
    <string name="tip_animals_2_title">Penampungan yang menerima bantuan</string>
    <string name="tip_animals_2_body">Beberapa yayasan terdampak menerima makanan, obat, dan perlengkapan (mis. di Pereira, Armenia, Manizales, dan Villa María). Verifikasi salurannya sebelum berdonasi; banyak yang disebarkan lewat Protección Animal Javeriana.</string>
    <string name="tip_animals_3_title">Perawatan hewan</string>
    <string name="tip_animals_3_body">Dokter hewan dan klinik merawat hewan terdampak di area gempa (mis. Royi Pets di Cali menampung hewan yang kebingungan). Konfirmasi ketersediaan sebelum berangkat.</string>
    <string name="tip_animals_4_title">Pencari hewan hilang</string>
    <string name="tip_animals_4_body">Platform komunitas “Buscador de Personas y Mascotas — terremoto Colombia” memungkinkan Anda melaporkan dan mencari hewan yang hilang. Ini sumber komunitas; verifikasi data sebelum bertindak.</string>
    <string name="desktop_number_copied">Nomor disalin ke papan klip</string>
