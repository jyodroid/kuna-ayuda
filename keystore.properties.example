# Copy to "keystore.properties" (gitignored) and fill in real values to sign the release AAB/APK.
# Generate the keystore first (see README / the Play release guide):
#   keytool -genkeypair -v -keystore kuna-upload.jks -alias kuna-upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repo root.
storeFile=kuna-upload.jks
storePassword=CHANGE_ME
keyAlias=kuna-upload
keyPassword=CHANGE_ME
